{
  "name": "calcium",
  "productName": "Calcium",
  "version": "1.4.3",
  "description": "Calcium — a bare bones browser.",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "node tools/dev.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "vmp-dev": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "start:electron": "electron .",
    "update-ublock": "node tools/update-ublock.js",
    "prepare-security": "node tools/prepare-security.js",
    "postinstall": "node tools/prepare-security.js",
    "test:security": "node tools/test-pentest.cjs && node tools/test-webstore-origin.cjs && node tools/test-security.cjs && node tools/test-protection.cjs && node tools/test-device-policy.cjs && node tools/test-language-permissions.cjs && node tools/test-private-ubo.cjs && node tools/test-private-content-unit.cjs && node tools/test-stdio.cjs && node tools/test-app-updates.cjs && node tools/test-custom-shortcuts.cjs",
    "test:electron": "node tools/run-electron-tests.cjs",
    "check:engine": "node tools/check-engine.cjs",
    "update-protection": "node tools/update-protection.cjs",
    "bench:memory": "node tools/run-memory-bench.cjs",
    "test:memory": "node tools/test-memory.cjs",
    "bench:soak": "node tools/run-soak-bench.cjs",
    "test:update:windows": "node tools/test-windows-update.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "electron": "https://codeload.github.com/castlabs/electron-releases/tar.gz/refs/tags/v45.2.1%2Bwvcus",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.cnrgks.calcium",
    "productName": "Calcium",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "files": [
      "main.js",
      "ui.html",
      "ui-preload.js",
      "page-preload.js",
      "newtab.html",
      "welcome.html",
      "history.html",
      "downloads.html",
      "settings.html",
      "reader.js",
      "volume.js",
      "hoverzoom.js",
      "extensions.html",
      "user-scripts.js",
      "user-scripts-sw.js",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "mv2-bridge.js",
      "vendor/**/*",
      "site-data.js",
      "bookmark-import.js",
      "i18n.js",
      "taskmanager.html",
      "bounded-fetch.js",
      "secure-crx.js",
      "browser-security.js",
      "extension-permissions.js",
      "threat-protection.js",
      "securitywarning.html",
      "private-ubo.js",
      "overlay-scrollbar.js",
      "calcium-protection.js",
      "device-policy.js",
      "memory-policy.js",
      "bounded-work-queue.js",
      "bounded-json.js",
      "ui-fonts.js",
      "browser-font.js",
      "context-menu-model.js",
      "private-content.js",
      "private-content-preload.js",
      "app-updates.js",
      "update-notice.html",
      "custom-shortcuts.js",
      "text-expansion.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calcium",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Calcium",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Calcium-Setup-${version}.exe",
      "guid": "ddf0f384-1d45-4192-9c12-84227af85eb4"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Calcium-${version}-${arch}.dmg",
      "icon": "build/icon-mac.png"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "build/vmp-win.js",
    "afterPack": "build/vmp-mac.js",
    "asarUnpack": [
      "vendor/ublock/**"
    ],
    "beforeBuild": "./build/prepare-security.js",
    "extraResources": [
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "@types/chrome/**/*",
          "@types/filesystem/**/*",
          "@types/filewriter/**/*",
          "@types/har-format/**/*",
          "adm-zip/**/*",
          "debug/**/*",
          "electron-chrome-extensions/**/*",
          "electron-chrome-web-store/**/*",
          "ms/**/*",
          "pbf/**/*",
          "protocol-buffers-schema/**/*",
          "resolve-protobuf-schema/**/*",
          "tldts/**/*",
          "tldts-core/**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "calcium.ico"
      }
    ]
  },
  "author": "cnrgks",
  "allowScripts": {
    "electron": true
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "minimatch@>=7 <11.0.1": "11.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
